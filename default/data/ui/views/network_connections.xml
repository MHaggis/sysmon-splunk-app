<form version="1.1">
  <label>Network Connections</label>
  <fieldset autoRun="true" submitButton="true">
    <input type="time" token="timsel" searchWhenChanged="true">
      <label></label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="text" token="imgsel">
      <label>Image</label>
      <default>*</default>
    </input>
    <input type="text" token="destinations">
      <label>Destinations</label>
      <default>*</default>
    </input>
    <input type="text" token="portsel">
      <label>Ports</label>
      <default>*</default>
    </input>
    <input type="text" token="protosel">
      <label>Protocols</label>
      <default>*</default>
    </input>
  </fieldset>
  <row>
    <panel>
      <table>
        <search>
          <query>`sysmon` EventCode=3 sysmon_process_path=$imgsel|s$ sysmon_protocol=$protosel|s$ sysmon_dest_port=$portsel|s$ (sysmon_dest_host=$destinations|s$ OR sysmon_dest_ip=$destinations|s$) | stats count, values(sysmon_dest_host) AS "Destinations", values(sysmon_dest_port) AS "Ports", values(sysmon_protocol) AS "Protocols" by sysmon_process_path | rename sysmon_process_path AS Image | fields Image Destinations Ports Protocols count</query>
          <earliest>$timsel.earliest$</earliest>
          <latest>$timsel.latest$</latest>
          <sampleRatio>1</sampleRatio>
        </search>
        <option name="count">20</option>
        <option name="dataOverlayMode">none</option>
        <option name="drilldown">cell</option>
        <option name="percentagesRow">false</option>
        <option name="rowNumbers">false</option>
        <option name="totalsRow">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
</form>
