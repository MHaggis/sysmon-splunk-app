<form version="1.1">
  <label>Process Watch</label>
  <fieldset autoRun="true" submitButton="true">
    <input type="time" token="time" searchWhenChanged="true">
      <label></label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Powershell Commands</title>
      <table>
        <search>
          <query>`sysmon` EventCode=1
(sysmon_process_path="C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe" OR sysmon_process_path="C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe") | stats count by CommandLine | sort -count</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
          <sampleRatio>1</sampleRatio>
        </search>
        <option name="count">20</option>
        <option name="dataOverlayMode">none</option>
        <option name="drilldown">cell</option>
        <option name="percentagesRow">false</option>
        <option name="rowNumbers">false</option>
        <option name="totalsRow">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>CMD Commands</title>
      <table>
        <search>
          <query>`sysmon` EventCode=1 sysmon_process_path="C:\\Windows\\System32\\cmd.exe" | stats count by CommandLine | sort -count</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
          <sampleRatio>1</sampleRatio>
        </search>
        <option name="count">20</option>
        <option name="dataOverlayMode">none</option>
        <option name="drilldown">cell</option>
        <option name="percentagesRow">false</option>
        <option name="rowNumbers">false</option>
        <option name="totalsRow">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
</form>
